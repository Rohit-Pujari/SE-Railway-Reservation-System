digraph RailwayReservation {
  graph [rankdir=TB, bgcolor=white, nodesep=0.4];
  node [shape=box, fontname=Arial, color=black];
  Browser [label="Passenger / Administrator Browser"];
  UI [label="React + Vite User Interface"];
  API [label="Django REST API / Session / CSRF / Role Checks"];
  Search [label="Train Search and Seat Availability"];
  Booking [label="Booking and Fare"];
  Payment [label="Simulated Payment"];
  Cancel [label="Cancellation and Pending Refunds"];
  Admin [label="Railway Administration"];
  DB [shape=cylinder,label="MySQL / InnoDB"];
  Browser -> UI -> API;
  API -> {Search Booking Payment Cancel Admin};
  {Search Booking Payment Cancel Admin} -> DB;
}