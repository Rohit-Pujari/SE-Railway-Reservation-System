# Application
# Use APP_DEBUG=true only for local development.
APP_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret_before_deployment
# Session and CSRF cookies default to Secure when APP_DEBUG=false.
# Set APP_DEBUG=true for local HTTP development; if TLS terminates at a proxy,
# keep Secure enabled and configure the proxy to serve the app only over HTTPS.
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: enable HSTS only after HTTPS is correctly configured end-to-end.
# SECURE_HSTS_SECONDS=31536000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=railway_reservation
DB_USER=root
DB_PASSWORD=change_me
