# Application
APP_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret_before_deployment
# Set true when served over HTTPS in production
SESSION_COOKIE_SECURE=false
ALLOWED_HOSTS=127.0.0.1,localhost
# run-dev.sh supplies these local origins automatically. Set explicitly when
# starting Django and Vite separately; production must use its actual origins.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=railway_reservation
DB_USER=root
DB_PASSWORD=change_me
